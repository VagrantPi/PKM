    },
    {
      "id": "cat4",
      "type": "text",
      "text": "## 🌳 驗證與誘因設計",
      "x": 300,
      "y": 1810,
      "width": 220,
      "height": 60,
      "color": "5"
    },
    {
      "id": "leaf4-1",
      "x": 660,
      "y": 1710,
      "width": 320,
      "height": 110,
      "type": "text",
      "text": "**默克爾樹**\n讓輕節點高效驗證交易是否在區塊中"
    },
    {
      "id": "leaf4-2",
      "x": 660,
      "y": 1860,
      "width": 320,
      "height": 110,
      "type": "text",
      "text": "**誘因設計**\n區塊獎勵＋手續費，誠實挖礦才有利可圖"
    }
