    },
    {
      "id": "cat3",
      "type": "text",
      "text": "🧩 設計積木\n反覆出現、可重用",
      "x": 300,
      "y": 715,
      "width": 200,
      "height": 70,
      "color": "5"
    },
    {
      "id": "cat3-l1",
